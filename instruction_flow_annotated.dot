digraph InstructionFlowAnnotated {
    rankdir=TB;
    node [shape=box, style=filled, fillcolor=lightblue, fontname="Courier", fontsize=10];
    edge [fontname="Courier", fontsize=8, color="#4a90e2"];
    
    // Title
    labelloc="t";
    label="OSM Black Hole Fall - Instruction Flow with Register Frequencies\nConformal Arrows Annotated with Register Values";
    fontsize=14;
    
    // Legend
    subgraph cluster_legend {
        label="Legend";
        style=filled;
        fillcolor=lightyellow;
        
        legend [shape=plaintext, label=<
            <table border="0" cellborder="1" cellspacing="0">
                <tr><td><b>Register Decoding</b></td></tr>
                <tr><td>NULL = 0x0</td></tr>
                <tr><td>42 = Answer to Everything</td></tr>
                <tr><td>Stack@ = Stack pointer</td></tr>
                <tr><td>Heap@ = Heap allocation</td></tr>
                <tr><td>Code@ = Code pointer</td></tr>
                <tr><td>(×N) = Frequency count</td></tr>
            </table>
        >];
    }
    
    "0x555555555000" [label="0x555555555000\npush rbp\nSave base pointer\nrax=NULL rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x555555555001" [label="0x555555555001\nmov rbp, rsp\nSet up stack frame\nrax=NULL rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x555555555004" [label="0x555555555004\nsub rsp, 32\nAllocate stack space\nrax=NULL rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x555555555008" [label="0x555555555008\nmov rax, [rbp-8]\nLoad node pointer\nrax=Heap@0x7f1234567890 rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x55555555500c" [label="0x55555555500c\ntest rax, rax\nCheck if null\nrax=Heap@0x7f1234567890 rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x55555555500f" [label="0x55555555500f\nje .L_null\nJump if null", fillcolor=lightyellow];
    "0x555555555014" [label="0x555555555014\ncall calculate_hawking_radiation\nCompute Hawking radiation\nrax=Heap@0x7f1234567890 rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightcoral];
    "0x555555555019" [label="0x555555555019\nmov [rbp-16], rax\nStore radiation result\nrax=Stack@0x4e56789abcdef rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x55555555501d" [label="0x55555555501d\ncall render_shadow\nRender ASCII shadow\nrax=Stack@0x4e56789abcdef rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightcoral];
    "0x555555555020" [label="0x555555555020\nxor eax, eax\nReturn 0 (null case)", fillcolor=lightblue];
    "0x555555555022" [label="0x555555555022\nadd rsp, 32\nDeallocate stack\nrax=NULL rbx=42 (Answer)\nrcx=Heap@0x7fff12345678 rdx=0x5", fillcolor=lightblue];
    "0x555555555026" [label="0x555555555026\npop rbp\nRestore base pointer", fillcolor=lightblue];
    "0x555555555027" [label="0x555555555027\nret \nReturn to caller", fillcolor=lightgreen];

    "0x555555555000" -> "0x555555555001" [label="next", style=solid];
    "0x555555555001" -> "0x555555555004" [label="next", style=solid];
    "0x555555555004" -> "0x555555555008" [label="next", style=solid];
    "0x555555555008" -> "0x55555555500c" [label="rax=Heap@0x7f1234567890 (×3)", style=solid];
    "0x55555555500c" -> "0x55555555500f" [label="next", style=solid];
    "0x55555555500c" -> "0x555555555020" [label="next", style=solid];
    "0x55555555500f" -> "0x555555555020" [label="branch", style=dashed];
    "0x555555555014" -> "0x555555555019" [label="call\nrax=Heap@0x7f1234567890 (×3)", style=bold];
    "0x555555555019" -> "0x55555555501d" [label="next", style=solid];
    "0x55555555501d" -> "0x555555555022" [label="call\nrax=Stack@0x4e56789abcdef (×2)", style=bold];
    "0x555555555020" -> "0x555555555022" [label="next", style=solid];
    "0x555555555022" -> "0x555555555026" [label="next", style=solid];
    "0x555555555026" -> "0x555555555027" [label="next", style=solid];
}
